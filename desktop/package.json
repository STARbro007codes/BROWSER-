{
  "name": "sitelock-desktop-browser",
  "version": "1.0.0",
  "description": "Production-ready, dedicated locked single-site desktop browser container for Windows, macOS, and Linux",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main/main.js",
    "build": "tsc",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "keywords": [
    "browser",
    "single-site",
    "kiosk",
    "security",
    "electron"
  ],
  "author": "SiteLock Engineering",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
